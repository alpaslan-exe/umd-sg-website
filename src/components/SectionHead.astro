---
interface Props { eyebrow?: string; title: string; lede?: string; center?: boolean }
const { eyebrow, title, lede, center = false } = Astro.props;
---
<div class:list={['sh', { 'sh--center': center }]}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2 set:html={title} />
  {lede && <p class="lede">{lede}</p>}
</div>
<style>
  .sh { margin-bottom: 2rem; }
  .sh--center { text-align: center; }
  .sh--center .eyebrow::before { margin-inline: auto; }
  .sh--center .lede { margin-inline: auto; }
</style>
