---
import settings from '../data/settings.json';
import { url } from '../lib/url';
const nav = [
  { label: 'About', href: '/about' },
  { label: 'Executive Board', href: '/board' },
  { label: 'Senate', href: '/senate' },
  { label: 'Initiatives', href: '/initiatives' },
  { label: 'Events', href: '/events' },
  { label: 'News', href: '/news' },
  { label: 'Governance', href: '/governance' },
  { label: 'Contact', href: '/contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => path === url(href).replace(/\/$/, '') || (href !== '/' && path.startsWith(url(href).replace(/\/$/, '') + '/'));
const ann = settings.announcement;
---
{ann?.enabled && ann.text && (
  <div class="announce">
    <div class="container announce__in">
      <span class="announce__dot" aria-hidden="true"></span>
      <span>{ann.text}</span>
      {ann.url && <a href={url(ann.url)}>Learn more <span aria-hidden="true">→</span></a>}
    </div>
  </div>
)}
<header class="hdr">
  <div class="container hdr__in">
    <a class="brand" href={url('/')} aria-label={`${settings.short_name} home`}>
      <img src={url('/img/roundel.png')} alt="" width="56" height="56" />
      <span class="brand__text">
        <span class="brand__l1">Student Government</span>
        <span class="brand__l2">UM-Dearborn</span>
      </span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav" class="nav" aria-label="Primary">
      <ul>
        {nav.map((n) => (
          <li><a href={url(n.href)} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
        <li class="nav__cta"><a class="btn btn--maize btn--sm" href={settings.join_url} target="_blank" rel="noopener noreferrer">Join SG</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    nav?.classList.toggle('is-open', !open);
    document.body.classList.toggle('nav-open', !open);
  });
</script>

<style>
  .announce { background: var(--maize); color: var(--navy); font-size: .92rem; font-weight: 600; }
  .announce__in { display: flex; gap: .7rem; align-items: center; padding-block: .45rem; flex-wrap: wrap; }
  .announce__dot { width: 9px; height: 9px; border-radius: 50%; background: var(--navy); flex: none; }
  .announce a { color: var(--navy); font-weight: 700; margin-left: auto; }
  .hdr { position: sticky; top: 0; z-index: 50; background: var(--navy); color: var(--white); border-bottom: 3px solid var(--maize); }
  .hdr__in { display: flex; align-items: center; gap: 1.25rem; min-height: 76px; }
  .brand { display: flex; align-items: center; gap: .8rem; color: var(--white); text-decoration: none; }
  .brand img { width: 52px; height: 52px; }
  .brand__text { display: flex; flex-direction: column; line-height: 1.05; font-family: var(--serif); }
  .brand__l1 { font-weight: 700; font-size: 1.05rem; letter-spacing: .02em; text-transform: uppercase; }
  .brand__l2 { color: var(--maize); font-size: .85rem; letter-spacing: .06em; text-transform: uppercase; }
  .nav { margin-left: auto; }
  .nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: .1rem; align-items: center; }
  .nav a:not(.btn) { color: rgba(255, 255, 255, .9); text-decoration: none; padding: .55rem .7rem; border-radius: 8px; font-weight: 600; font-size: .95rem; }
  .nav a:not(.btn):hover, .nav a[aria-current="page"] { color: var(--maize); background: rgba(255, 255, 255, .06); }
  .nav__cta { margin-left: .5rem; }
  .nav-toggle { display: none; margin-left: auto; background: none; border: 2px solid rgba(255,255,255,.4); border-radius: 8px; width: 44px; height: 40px; padding: 8px; flex-direction: column; justify-content: space-between; cursor: pointer; }
  .nav-toggle span { display: block; height: 3px; background: var(--maize); border-radius: 2px; }
  @media (max-width: 1080px) {
    .nav-toggle { display: flex; }
    .nav { display: none; position: absolute; left: 0; right: 0; top: 100%; background: var(--navy); border-bottom: 3px solid var(--maize); padding: .75rem 1.25rem 1.25rem; box-shadow: var(--shadow); }
    .nav.is-open { display: block; }
    .nav ul { flex-direction: column; align-items: stretch; }
    .nav a:not(.btn) { display: block; padding: .8rem .6rem; font-size: 1.05rem; }
    .nav__cta { margin: .5rem 0 0; }
    .brand__l1 { font-size: .95rem; }
  }
</style>
